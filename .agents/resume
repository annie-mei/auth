#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
echo "Ensuring the local test database is running..."
amp orb services ensure
for attempt in {1..5}; do
  if /usr/lib/postgresql/15/bin/pg_isready -h 127.0.0.1 -p 55432 -U postgres -t 1; then
    exit 0
  fi
  sleep 1
done
/usr/lib/postgresql/15/bin/pg_isready -h 127.0.0.1 -p 55432 -U postgres
